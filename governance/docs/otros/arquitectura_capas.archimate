<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:archimate="http://www.archimatetool.com/archimate" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="MIS Host · idea del proyecto y arquitectura de negocio" id="id-modelo-mis" version="4.9.0">
  <purpose>Modelo de arquitectura empresarial del proyecto de reingeniería del Sistema de Información Gerencial (MIS) de una entidad microfinanciera. El alcance de este modelo es la idea del proyecto y el negocio al que sirve: por qué se hace, para quién, con qué objetivos y restricciones, y con qué hoja de ruta.</purpose>
  <folder name="Strategy" id="id-folder-strategy" type="strategy" />
  <folder name="Business" id="id-folder-business" type="business">
    <element xsi:type="archimate:BusinessActor" name="Asesor de negocios" id="act-asesor">
      <documentation>Consulta su propia cartera y coloca productos en campo.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Supervisor de unidad" id="act-supervisor">
      <documentation>Consulta su unidad y las agencias a su cargo.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Administrador del sistema" id="act-admin">
      <documentation>Recorre la jerarquía completa y administra accesos.</documentation>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Consumidor de información gerencial" id="rol-consumidor">
      <documentation>Rol común: quien necesita una cifra para decidir.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Consulta de información gerencial" id="srv-consulta">
      <documentation>Entrega el indicador pedido para un nodo de la jerarquía y una fecha de corte.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Gestión comercial basada en información" id="prc-gestion">
      <documentation>Proceso raíz que agrupa los cuatro pasos de una consulta.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Autenticar e identificar el alcance" id="prc-autenticar">
      <documentation>Del perfil salen el código de negocio, el nodo y la fecha de corte.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Delimitar el alcance de la consulta" id="prc-delimitar">
      <documentation>Elegir nodo de jerarquía y período.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Consultar el indicador" id="prc-consultar">
      <documentation>Reporte, tablero o tarjeta según el caso.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Decidir y gestionar" id="prc-decidir">
      <documentation>Colocación, seguimiento de mora, evaluación de incentivos.</documentation>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="Cierre de la fecha de corte" id="evt-corte">
      <documentation>El backend habilita la información del período; antes, la consulta no tiene sentido.</documentation>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Monitoreo de cartera" id="fun-cartera">
      <documentation>Saldos vigentes, desembolsos y composición por segmento.</documentation>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Gestión de mora" id="fun-mora">
      <documentation>Tramos, recuperación y acciones preventivas.</documentation>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Evaluación de incentivos" id="fun-incentivos">
      <documentation>Avance de variables, bonos y simulación.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Jerarquía organizativa" id="obn-jerarquia">
      <documentation>Territorio, corredor, unidad, agencia y asesor.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Indicador de gestión" id="obn-indicador">
      <documentation>La cifra sobre la que se decide.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Fecha de corte" id="obn-fecha">
      <documentation>Momento al que corresponde la información.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Identidad y alcance autorizado" id="obn-identidad">
      <documentation>Quién consulta y hasta dónde llega su alcance.</documentation>
    </element>
  </folder>
  <folder name="Application" id="id-folder-application" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="MIS Host" id="app-mis">
      <documentation>Portal de información gerencial reconstruido por este proyecto.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Servicio de información gerencial" id="app-srv">
      <documentation>Lo que el MIS ofrece al proceso de negocio.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Núcleo · core" id="app-nucleo">
      <documentation>Sesión, guardas de ruta, interceptores HTTP y cifrado de la carga útil.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Winder · transporte Ant" id="app-winder">
      <documentation>Diez servicios de instancia sobre seis puertos; traduce la llamada de dominio a ruta de acción.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Doce módulos de negocio" id="app-modulos">
      <documentation>Cada uno con carga diferida: su código se descarga al navegar a él.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Biblioteca compartida · shared/ui" id="app-shared">
      <documentation>Tabla de datos, selector de jerarquía, diálogos y ventana: lo común a todos los módulos.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Sesión del usuario" id="dat-sesion">
      <documentation>Identidad, código de negocio, rol y vencimiento. Clave `mis.sesion`.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Árbol de jerarquía" id="dat-jerarquia">
      <documentation>Nodos ya resueltos del organigrama. Claves con prefijo `mis.jerarquia.`.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Respuesta de reporte" id="dat-respuesta">
      <documentation>La cifra devuelta por Ant con su nodo y su fecha de corte. Nunca se persiste.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Preferencias de interfaz" id="dat-preferencias">
      <documentation>Tema, fondo, acento, menú y reportes recientes. Clave `mis.preferencias`.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Comunicados ya vistos" id="dat-comunicados">
      <documentation>Identificadores acusados en esta sesión. Clave `mis.comunicados.sesion`.</documentation>
    </element>
  </folder>
  <folder name="Technology &amp; Physical" id="id-folder-technology" type="technology">
    <element xsi:type="archimate:Artifact" name="sessionStorage del navegador" id="art-session">
      <documentation>Vive hasta que se cierra la pestaña. Aloja sesión, jerarquía y comunicados.</documentation>
    </element>
    <element xsi:type="archimate:Artifact" name="Estado en memoria · señales" id="art-memoria">
      <documentation>Se pierde al recargar, y esa es la intención: obliga a volver a preguntarle a Ant.</documentation>
    </element>
    <element xsi:type="archimate:Artifact" name="localStorage del navegador" id="art-local">
      <documentation>Lo único permanente del cliente: la preferencia de interfaz.</documentation>
    </element>
    <element xsi:type="archimate:Artifact" name="Paquete inicial · 249,08 kB" id="art-bundle">
      <documentation>Lo que el navegador descarga antes de pintar la primera pantalla útil.</documentation>
    </element>
    <element xsi:type="archimate:Artifact" name="253 paquetes diferidos" id="art-chunks">
      <documentation>No viajan en el arranque: se piden al navegar al módulo.</documentation>
    </element>
    <element xsi:type="archimate:Artifact" name="Caché del service worker" id="art-ngsw">
      <documentation>Solo el esqueleto de la aplicación: `ngsw-config.json` no declara ningún dataGroup.</documentation>
    </element>
    <element xsi:type="archimate:Device" name="Equipo del usuario" id="tec-equipo">
      <documentation>Estación de trabajo de agencia o equipo móvil en campo.</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="Navegador web" id="tec-navegador">
      <documentation>Motor de JavaScript, almacenamiento local y service worker.</documentation>
    </element>
    <element xsi:type="archimate:CommunicationNetwork" name="Red corporativa" id="tec-red">
      <documentation>Enlace entre la agencia y el centro de datos. Fuera del alcance del proyecto.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="Servidor de contenido estático" id="tec-web">
      <documentation>Entrega el paquete inicial y los paquetes diferidos.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="Backend Ant · cores2" id="tec-ant">
      <documentation>Aloja las diez instancias de aplicación y resuelve 62 rutas de acción.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="Base de datos corporativa" id="tec-bd">
      <documentation>Almacén real del dato. El frontend no la alcanza nunca de forma directa.</documentation>
    </element>
    <element xsi:type="archimate:TechnologyService" name="Transporte HTTPS" id="tsrv-https">
      <documentation>Canal cifrado entre el navegador y el centro de datos.</documentation>
    </element>
    <element xsi:type="archimate:TechnologyService" name="Almacenamiento del navegador" id="tsrv-almacen">
      <documentation>Las dos vigencias que ofrece el cliente: sesión y permanente.</documentation>
    </element>
    <element xsi:type="archimate:TechnologyService" name="Servicios Ant · 10 instancias / 6 puertos" id="tsrv-ant">
      <documentation>Puertos 6300, 6301, 6302, 5301, 5304 y 6304 bajo `cores2/ant`.</documentation>
    </element>
  </folder>
  <folder name="Motivation" id="id-folder-motivation" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="Jefatura de Tecnología" id="int-jefatura">
      <documentation>Aprueba los entregables y los hitos del proyecto.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Gerencia Comercial" id="int-comercial">
      <documentation>Consume la información para dirigir la fuerza de ventas.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Fuerza de ventas" id="int-usuario">
      <documentation>Asesores y supervisores que usan el MIS en jornada operativa.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Seguridad de la Información" id="int-seguridad">
      <documentation>Vela por el tratamiento del dato y el cumplimiento normativo.</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Rendimiento del MIS" id="drv-rendimiento">
      <documentation>El sistema tarda en mostrar la información que sostiene la decisión comercial.</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Oportunidad de la información" id="drv-oportunidad">
      <documentation>La cifra sirve si llega en el momento en que se decide, no después.</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Costo de evolución del sistema" id="drv-mantenimiento">
      <documentation>Cada funcionalidad nueva es más cara sobre una base monolítica y acoplada.</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="Tiempos de carga y renderizado elevados" id="dia-tiempos">
      <documentation>Bloqueos perceptibles de la interfaz al consultar grandes volúmenes.</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="Arquitectura monolítica: 312 módulos declarados" id="dia-monolito">
      <documentation>Angular 14 con alto acoplamiento entre módulos y componentes.</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="Detección de cambios con Zone.js" id="dia-zonejs">
      <documentation>Cada evento asíncrono dispara verificación del árbol completo.</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="Sin suite de pruebas versionada" id="dia-pruebas">
      <documentation>No hay red que detecte una regresión antes del despliegue.</documentation>
    </element>
    <element xsi:type="archimate:Goal" name="Reducir los tiempos de respuesta y renderizado" id="obj-tiempos">
      <documentation>Objetivo general del proyecto, medido con ISO/IEC 25010 · eficiencia de desempeño.</documentation>
    </element>
    <element xsi:type="archimate:Goal" name="Sostener el rendimiento en el tiempo" id="obj-sostener">
      <documentation>Que la mejora no se degrade con las funcionalidades siguientes.</documentation>
    </element>
    <element xsi:type="archimate:Goal" name="Mantener la continuidad operativa" id="obj-continuidad">
      <documentation>El sistema heredado sigue disponible durante toda la migración.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Componentes standalone" id="req-standalone">
      <documentation>Sin módulos declarados: el componente declara sus propias dependencias.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Carga diferida de rutas y recursos" id="req-lazy">
      <documentation>El código de un módulo se descarga al navegar a él por primera vez.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Reactividad con señales y ejecución zoneless" id="req-zoneless">
      <documentation>Actualización granular: solo los consumidores de la señal que cambió.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Verificación automatizada en cada integración" id="req-verificacion">
      <documentation>Compuertas de arquitectura, documentación, tokens, inventarios y activos.</documentation>
    </element>
    <element xsi:type="archimate:Constraint" name="No se modifican los contratos del backend" id="res-contratos">
      <documentation>El alcance es la capa de presentación: Ant y Winder quedan intactos.</documentation>
    </element>
    <element xsi:type="archimate:Constraint" name="No se interviene la infraestructura de red" id="res-red">
      <documentation>La latencia física del enlace está fuera del alcance del proyecto.</documentation>
    </element>
    <element xsi:type="archimate:Principle" name="El frontend no es fuente de verdad" id="pri-verdad">
      <documentation>No crea ni corrige datos de negocio: los transforma para presentarlos.</documentation>
    </element>
    <element xsi:type="archimate:Principle" name="Vacío y error son estados distintos" id="pri-vacio">
      <documentation>Una consulta fallida no es "sin datos".</documentation>
    </element>
    <element xsi:type="archimate:Principle" name="Toda cifra debe poder trazarse hasta su origen" id="pri-trazable">
      <documentation>cod_rep, nodo de jerarquía y fecha de corte, siempre identificables.</documentation>
    </element>
    <element xsi:type="archimate:Outcome" name="Paquete inicial de 249,08 kB" id="out-paquete">
      <documentation>Lo que el navegador descarga antes de pintar la primera pantalla útil.</documentation>
    </element>
    <element xsi:type="archimate:Outcome" name="12 módulos con carga diferida" id="out-modulos">
      <documentation>253 paquetes diferidos; ninguno viaja en el arranque.</documentation>
    </element>
    <element xsi:type="archimate:Outcome" name="0 módulos declarados" id="out-ngmodules">
      <documentation>Frente a 312 en el sistema heredado.</documentation>
    </element>
    <element xsi:type="archimate:Outcome" name="356 pruebas y 6 compuertas" id="out-pruebas">
      <documentation>Suite unitaria, 30 suites E2E y verificación automatizada.</documentation>
    </element>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-folder-implementation_migration" type="implementation_migration">
    <element xsi:type="archimate:Plateau" name="Situación actual · MIS heredado" id="pla-asis">
      <documentation>Angular 14, monolítico, con Zone.js y sin pruebas versionadas.</documentation>
    </element>
    <element xsi:type="archimate:Gap" name="Brecha de rendimiento y evolución" id="gap-rendimiento">
      <documentation>Distancia entre lo que el negocio necesita y lo que el sistema entrega.</documentation>
    </element>
    <element xsi:type="archimate:Plateau" name="Situación objetivo · MIS modular" id="pla-tobe">
      <documentation>Angular 22, standalone, zoneless, con carga diferida y verificación automatizada.</documentation>
    </element>
    <element xsi:type="archimate:WorkPackage" name="1 · Inicio" id="wp-inicio">
      <documentation>Acta de constitución, interesados y alcance. 16 días.</documentation>
    </element>
    <element xsi:type="archimate:WorkPackage" name="2 · Planificación" id="wp-planificacion">
      <documentation>Modelo de seguridad, arquitectura objetivo y backlog. 35 días.</documentation>
    </element>
    <element xsi:type="archimate:WorkPackage" name="3 · Ejecución" id="wp-ejecucion">
      <documentation>Núcleo y migración de los doce módulos. 168 días.</documentation>
    </element>
    <element xsi:type="archimate:WorkPackage" name="4 · Monitoreo y control" id="wp-control">
      <documentation>Integración continua, regresiones y deuda técnica. 161 días.</documentation>
    </element>
    <element xsi:type="archimate:WorkPackage" name="5 · Cierre" id="wp-cierre">
      <documentation>Informe, evaluación de calidad y transferencia. 24 días.</documentation>
    </element>
    <element xsi:type="archimate:Deliverable" name="IE1 · Diagnóstico y línea base" id="ent-diagnostico">
      <documentation>Indicadores de rendimiento del sistema heredado, aprobados por la jefatura.</documentation>
    </element>
    <element xsi:type="archimate:Deliverable" name="IE2 · Documento de arquitectura" id="ent-arquitectura">
      <documentation>Validado por especialistas, con 90 % de aceptación mínima.</documentation>
    </element>
    <element xsi:type="archimate:Deliverable" name="IE3 · Sistema en certificación" id="ent-sistema">
      <documentation>Módulos standalone con carga diferida, desplegados.</documentation>
    </element>
    <element xsi:type="archimate:Deliverable" name="IE4 · Informe comparativo" id="ent-informe">
      <documentation>Contraste de indicadores contra la línea base.</documentation>
    </element>
  </folder>
  <folder name="Other" id="id-folder-other" type="other" />
  <folder name="Relations" id="id-folder-relations" type="relations">
    <element xsi:type="archimate:AssociationRelationship" id="r-int1" source="int-jefatura" target="drv-rendimiento" />
    <element xsi:type="archimate:AssociationRelationship" id="r-int2" source="int-comercial" target="drv-oportunidad" />
    <element xsi:type="archimate:AssociationRelationship" id="r-int3" source="int-usuario" target="drv-rendimiento" />
    <element xsi:type="archimate:AssociationRelationship" id="r-int4" source="int-seguridad" target="drv-mantenimiento" />
    <element xsi:type="archimate:AssociationRelationship" id="r-dia1" source="dia-tiempos" target="drv-rendimiento" />
    <element xsi:type="archimate:AssociationRelationship" id="r-dia2" source="dia-monolito" target="drv-mantenimiento" />
    <element xsi:type="archimate:AssociationRelationship" id="r-dia3" source="dia-zonejs" target="drv-rendimiento" />
    <element xsi:type="archimate:AssociationRelationship" id="r-dia4" source="dia-pruebas" target="drv-mantenimiento" />
    <element xsi:type="archimate:InfluenceRelationship" id="r-drv1" source="drv-rendimiento" target="obj-tiempos" />
    <element xsi:type="archimate:InfluenceRelationship" id="r-drv2" source="drv-oportunidad" target="obj-tiempos" />
    <element xsi:type="archimate:InfluenceRelationship" id="r-drv3" source="drv-mantenimiento" target="obj-sostener" />
    <element xsi:type="archimate:RealizationRelationship" id="r-req1" source="req-standalone" target="obj-tiempos" />
    <element xsi:type="archimate:RealizationRelationship" id="r-req2" source="req-lazy" target="obj-tiempos" />
    <element xsi:type="archimate:RealizationRelationship" id="r-req3" source="req-zoneless" target="obj-tiempos" />
    <element xsi:type="archimate:RealizationRelationship" id="r-req4" source="req-verificacion" target="obj-sostener" />
    <element xsi:type="archimate:InfluenceRelationship" id="r-res1" source="res-contratos" target="obj-continuidad" />
    <element xsi:type="archimate:InfluenceRelationship" id="r-res2" source="res-red" target="obj-tiempos" />
    <element xsi:type="archimate:AssociationRelationship" id="r-res3" source="res-contratos" target="app-mis" />
    <element xsi:type="archimate:RealizationRelationship" id="r-pri1" source="res-contratos" target="pri-verdad" />
    <element xsi:type="archimate:RealizationRelationship" id="r-pri2" source="req-verificacion" target="pri-vacio" />
    <element xsi:type="archimate:RealizationRelationship" id="r-pri3" source="req-verificacion" target="pri-trazable" />
    <element xsi:type="archimate:RealizationRelationship" id="r-out1" source="out-paquete" target="obj-tiempos" />
    <element xsi:type="archimate:RealizationRelationship" id="r-out2" source="out-modulos" target="obj-tiempos" />
    <element xsi:type="archimate:RealizationRelationship" id="r-out3" source="out-ngmodules" target="obj-tiempos" />
    <element xsi:type="archimate:RealizationRelationship" id="r-out4" source="out-pruebas" target="obj-sostener" />
    <element xsi:type="archimate:AssignmentRelationship" id="r-act1" source="act-asesor" target="rol-consumidor" />
    <element xsi:type="archimate:AssignmentRelationship" id="r-act2" source="act-supervisor" target="rol-consumidor" />
    <element xsi:type="archimate:AssignmentRelationship" id="r-act3" source="act-admin" target="rol-consumidor" />
    <element xsi:type="archimate:AssignmentRelationship" id="r-rol1" source="rol-consumidor" target="prc-gestion" />
    <element xsi:type="archimate:ServingRelationship" id="r-srv1" source="srv-consulta" target="rol-consumidor" />
    <element xsi:type="archimate:RealizationRelationship" id="r-prc0" source="prc-gestion" target="srv-consulta" />
    <element xsi:type="archimate:CompositionRelationship" id="r-cmp1" source="prc-gestion" target="prc-autenticar" />
    <element xsi:type="archimate:CompositionRelationship" id="r-cmp2" source="prc-gestion" target="prc-delimitar" />
    <element xsi:type="archimate:CompositionRelationship" id="r-cmp3" source="prc-gestion" target="prc-consultar" />
    <element xsi:type="archimate:CompositionRelationship" id="r-cmp4" source="prc-gestion" target="prc-decidir" />
    <element xsi:type="archimate:TriggeringRelationship" id="r-trg1" source="prc-autenticar" target="prc-delimitar" />
    <element xsi:type="archimate:TriggeringRelationship" id="r-trg2" source="prc-delimitar" target="prc-consultar" />
    <element xsi:type="archimate:TriggeringRelationship" id="r-trg3" source="prc-consultar" target="prc-decidir" />
    <element xsi:type="archimate:TriggeringRelationship" id="r-evt1" source="evt-corte" target="prc-consultar" />
    <element xsi:type="archimate:AccessRelationship" id="r-acc1" source="prc-autenticar" target="obn-identidad" accessType="1" />
    <element xsi:type="archimate:AccessRelationship" id="r-acc2" source="prc-delimitar" target="obn-jerarquia" accessType="1" />
    <element xsi:type="archimate:AccessRelationship" id="r-acc3" source="prc-consultar" target="obn-indicador" accessType="1" />
    <element xsi:type="archimate:AccessRelationship" id="r-acc4" source="prc-consultar" target="obn-fecha" accessType="1" />
    <element xsi:type="archimate:ServingRelationship" id="r-fun1" source="srv-consulta" target="fun-cartera" />
    <element xsi:type="archimate:ServingRelationship" id="r-fun2" source="srv-consulta" target="fun-mora" />
    <element xsi:type="archimate:ServingRelationship" id="r-fun3" source="srv-consulta" target="fun-incentivos" />
