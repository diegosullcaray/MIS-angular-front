          ], false, 'Emprendiendo Confianza · ordenado por saldo')
        ]
      }
    };

    var names = [['cartera', 'Cartera'], ['clientes', 'Clientes'], ['colocacion', 'Colocación'], ['tasas', 'Tasas'], ['seguros', 'Seguros'], ['mora', 'Mora']];
    var tabs = names.map(function (n) {
      return { label: n[1], go: go(n[0]), active: n[0] === cur, idle: n[0] !== cur };
    });

    var base = D[cur];
    var dlg = base ? Object.assign({}, noFilters, base) : Object.assign({ title: '', sub: '', kpis: [], sections: [] }, noFilters);

    return {
      isOpen: !!base,
      dlg: dlg,
      tabs: tabs,
      close: function () { self.setState({ open: 'none' }); },
      open: {
        cartera: go('cartera'), clientes: go('clientes'), colocacion: go('colocacion'),
        tasas: go('tasas'), seguros: go('seguros'), mora: go('mora')
      }
    };
  }
}
</script>
