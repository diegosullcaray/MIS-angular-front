<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>Dashboard de impacto del asesor</title>
<script src="./vendor/react.js"></script>
<script src="./vendor/react-dom.js"></script>
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&amp;family=IBM+Plex+Sans+Condensed:wght@500;600&amp;display=swap">
<style>html,body{margin:0;padding:0;background:#F3F4F1;min-height:100vh;width:100%}</style>
</helmet>
<div style="width: 100%; min-height: 100vh; box-sizing: border-box; padding: 14px 32px 18px; display: flex; flex-direction: column; gap: 12px; background: #F3F4F1; color: #16202E; font-family: 'IBM Plex Sans', system-ui, sans-serif; font-variant-numeric: tabular-nums">

<!-- Encabezado -->
<header style="display: flex; align-items: center; gap: 24px">
<div style="display: flex; flex-direction: column; gap: 4px; flex-grow: 1">
<h1 style="margin: 0; font-size: 22px; font-weight: 700; letter-spacing: -0.01em; color: #16202E">Asesor: Yactayo Luque Magali Mariet · Setiembre 2026</h1>
</div>
<div style="display: flex; align-items: center; gap: 10px">
<span style="font-size: 12px; color: #505A69; background: #FFFFFF; border: 1px solid #E1E4E8; border-radius: 999px; padding: 8px 14px">Corte al 29/09/2026</span>
<button type="button" aria-label="Filtros" style="width: 38px; height: 38px; border-radius: 999px; border: 1px solid #E1E4E8; background: #FFFFFF; color: #16202E; display: flex; align-items: center; justify-content: center; cursor: pointer"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 5h18l-7 8v6l-4-2v-4z"></path></svg></button>
<button type="button" aria-label="Actualizar" style="width: 38px; height: 38px; border-radius: 999px; border: 1px solid #E1E4E8; background: #FFFFFF; color: #16202E; display: flex; align-items: center; justify-content: center; cursor: pointer"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 11a8 8 0 1 0-2.3 5.7"></path><path d="M20 4v7h-7"></path></svg></button>
</div>
</header>



<!-- Tarjetas por dominio -->
<section aria-label="Dominios" style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px">

<!-- Cartera -->
<button type="button" onClick="{{open.cartera}}" style="font: inherit; color: inherit; text-align: left; cursor: pointer; background: #FFFFFF; border: 1px solid #E1E4E8; border-radius: 14px; padding: 16px 20px; display: flex; flex-direction: column; gap: 10px; min-height: 285px; box-sizing: border-box">
<div style="display: flex; align-items: center; gap: 10px; width: 100%"><span style="width: 36px; height: 36px; border-radius: 9px; background: #E7EEF7; color: #0B3D78; display: flex; align-items: center; justify-content: center"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2"></rect><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></span><span style="font-size: 16px; font-weight: 600; flex-grow: 1">Cartera</span><span style="font-size: 13px; font-weight: 600; color: #0B3D78">Ver detalle →</span></div>
<div style="display: flex; flex-direction: column; gap: 8px; width: 100%">
<div style="font-size: 12px; font-weight: 600; color: #505A69">Cartera Vigente</div>
<div style="display: flex; align-items: center; gap: 10px; font-size: 13px"><span style="width: 96px; color: #505A69">Cierre anterior</span><span style="flex-grow: 1; height: 10px; background: #EEF0EC; border-radius: 5px; display: flex"><span style="width: 86.1%; background: #9DB4D3; border-radius: 5px"></span></span><span style="width: 80px; text-align: right">3,528,967</span></div>
<div style="display: flex; align-items: center; gap: 10px; font-size: 13px"><span style="width: 96px; color: #505A69">Meta</span><span style="flex-grow: 1; height: 10px; background: #EEF0EC; border-radius: 5px; display: flex"><span style="width: 100%; background: #C77700; border-radius: 5px"></span></span><span style="width: 80px; text-align: right">4,100,000</span></div>
<div style="display: flex; align-items: center; gap: 10px; font-size: 13px"><span style="width: 96px; color: #505A69">Hoy</span><span style="flex-grow: 1; height: 10px; background: #EEF0EC; border-radius: 5px; display: flex"><span style="width: 79.4%; background: #0B3D78; border-radius: 5px"></span></span><span style="width: 80px; text-align: right; font-weight: 600">3,254,743</span></div>
</div>
<div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; width: 100%; margin-top: auto; border-top: 1px solid #EEF0EC; padding-top: 14px">
<div style="display: flex; flex-direction: column; gap: 4px"><span style="font-size: 12px; color: #505A69">Total Créditos</span><span style="font-size: 17px; font-weight: 600">154</span><span style="font-size: 12px; color: #1B6B43">+8 ops</span></div>
<div style="display: flex; flex-direction: column; gap: 4px"><span style="font-size: 12px; color: #505A69">Saldo Medio Vigente</span><span style="font-size: 17px; font-weight: 600">1,842,500</span><span style="font-size: 12px; color: #A1231B">−45,200</span></div>
<div style="display: flex; flex-direction: column; gap: 4px"><span style="font-size: 12px; color: #505A69">TAPP Stock</span><span style="font-size: 17px; font-weight: 600">24.15%</span><span style="font-size: 12px; color: #1B6B43">+45 pbs</span></div>
</div>
</button>

<!-- Clientes -->
<button type="button" onClick="{{open.clientes}}" style="font: inherit; color: inherit; text-align: left; cursor: pointer; background: #FFFFFF; border: 1px solid #E1E4E8; border-radius: 14px; padding: 16px 20px; display: flex; flex-direction: column; gap: 10px; min-height: 285px; box-sizing: border-box">
<div style="display: flex; align-items: center; gap: 10px; width: 100%"><span style="width: 36px; height: 36px; border-radius: 9px; background: #E7EEF7; color: #0B3D78; display: flex; align-items: center; justify-content: center"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.5"></circle><path d="M2.5 20a6.5 6.5 0 0 1 13 0"></path><path d="M16 4.5a3.5 3.5 0 0 1 0 7"></path><path d="M18 14a6 6 0 0 1 3.5 6"></path></svg></span><span style="font-size: 16px; font-weight: 600; flex-grow: 1">Clientes</span><span style="font-size: 13px; font-weight: 600; color: #0B3D78">Ver detalle →</span></div>
<div style="display: flex; flex-direction: column; gap: 8px; width: 100%">
<div style="font-size: 12px; font-weight: 600; line-height: 1.4; color: transparent; user-select: none; pointer-events: none" aria-hidden="true">Clientes</div>
<div style="display: flex; align-items: center; gap: 10px; font-size: 13px"><span style="width: 96px; color: #505A69">Cierre anterior</span><span style="flex-grow: 1; height: 10px; background: #EEF0EC; border-radius: 5px; display: flex"><span style="width: 88.8%; background: #9DB4D3; border-radius: 5px"></span></span><span style="width: 80px; text-align: right">142</span></div>
<div style="display: flex; align-items: center; gap: 10px; font-size: 13px"><span style="width: 96px; color: #505A69">Meta</span><span style="flex-grow: 1; height: 10px; background: #EEF0EC; border-radius: 5px; display: flex"><span style="width: 100%; background: #C77700; border-radius: 5px"></span></span><span style="width: 80px; text-align: right">160</span></div>
<div style="display: flex; align-items: center; gap: 10px; font-size: 13px"><span style="width: 96px; color: #505A69">Hoy</span><span style="flex-grow: 1; height: 10px; background: #EEF0EC; border-radius: 5px; display: flex"><span style="width: 89.4%; background: #0B3D78; border-radius: 5px"></span></span><span style="width: 80px; text-align: right; font-weight: 600">143</span></div>
</div>
<div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; width: 100%; margin-top: auto; border-top: 1px solid #EEF0EC; padding-top: 14px">
<div style="display: flex; flex-direction: column; gap: 4px"><span style="font-size: 12px; color: #505A69">Nuevo</span><span style="font-size: 17px; font-weight: 600">12</span><span style="font-size: 12px; color: #1B6B43">+3</span></div>
<div style="display: flex; flex-direction: column; gap: 4px"><span style="font-size: 12px; color: #505A69">Recurrente</span><span style="font-size: 17px; font-weight: 600">118</span><span style="font-size: 12px; color: #A1231B">−5</span></div>
<div style="display: flex; flex-direction: column; gap: 4px"><span style="font-size: 12px; color: #505A69">Bancarizado</span><span style="font-size: 17px; font-weight: 600">13</span><span style="font-size: 12px; color: #1B6B43">+4</span></div>
</div>
</button>

<!-- Desembolsos -->
<button type="button" onClick="{{open.colocacion}}" style="font: inherit; color: inherit; text-align: left; cursor: pointer; background: #FFFFFF; border: 1px solid #E1E4E8; border-radius: 14px; padding: 16px 20px; display: flex; flex-direction: column; gap: 10px; min-height: 285px; box-sizing: border-box">
<div style="display: flex; align-items: center; gap: 10px; width: 100%"><span style="width: 36px; height: 36px; border-radius: 9px; background: #E7EEF7; color: #0B3D78; display: flex; align-items: center; justify-content: center"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21V4"></path><path d="M4 4h12l-2 4 2 4H4"></path></svg></span><span style="font-size: 16px; font-weight: 600; flex-grow: 1">Desembolsos</span><span style="font-size: 13px; font-weight: 600; color: #0B3D78">Ver detalle →</span></div>
<div style="display: flex; flex-direction: column; gap: 10px; width: 100%">
<div style="display: flex; flex-direction: column; gap: 4px; width: 100%">
<div style="display: flex; justify-content: space-between; font-size: 13px"><span style="color: #16202E">Operaciones</span><span style="font-weight: 600; color: #505A69">Meta: 15</span></div>
<div style="position: relative; margin-top: 14px; height: 10px; background: #EEF0EC; border-radius: 5px; display: flex">
<span style="width: 53.33%; background: #C77700; border-radius: 5px"></span>
<span style="position: absolute; left: 53.33%; top: -18px; transform: translateX(-50%); font-size: 11px; font-weight: 700; color: #C77700; white-space: nowrap">8 ops</span>
<span style="position: absolute; left: 53.33%; top: -3px; width: 2px; height: 16px; background: #16202E; z-index: 2"></span>
<svg width="9" height="10" viewBox="0 0 10 10" style="position: absolute; left: 80%; top: -7px; transform: translateX(-50%); fill: #0B3D78; z-index: 3"><polygon points="0,0 10,0 5,8"></polygon></svg>
<span style="position: absolute; left: 80%; top: 0; width: 2px; height: 13px; background: #0B3D78; z-index: 2; transform: translateX(-50%)"></span>
</div>
</div>
<div style="display: flex; flex-direction: column; gap: 4px; width: 100%">
<div style="display: flex; justify-content: space-between; font-size: 13px"><span style="color: #16202E">Monto</span><span style="font-weight: 600; color: #505A69">Meta: 225,000</span></div>
<div style="position: relative; margin-top: 14px; height: 10px; background: #EEF0EC; border-radius: 5px; display: flex">
<span style="width: 42.5%; background: #0B3D78; border-radius: 5px"></span>
<span style="position: absolute; left: 42.5%; top: -18px; transform: translateX(-50%); font-size: 11px; font-weight: 700; color: #0B3D78; white-space: nowrap">95,620</span>
<span style="position: absolute; left: 42.5%; top: -3px; width: 2px; height: 16px; background: #16202E; z-index: 2"></span>
<svg width="9" height="10" viewBox="0 0 10 10" style="position: absolute; left: 80%; top: -7px; transform: translateX(-50%); fill: #0B3D78; z-index: 3"><polygon points="0,0 10,0 5,8"></polygon></svg>
<span style="position: absolute; left: 80%; top: 0; width: 2px; height: 13px; background: #0B3D78; z-index: 2; transform: translateX(-50%)"></span>
</div>
</div>
<div style="display: flex; align-items: center; gap: 14px; font-size: 11px; color: #505A69; margin-top: 2px"><span style="display: flex; align-items: center; gap: 4px"><span style="width: 2px; height: 11px; background: #16202E"></span>Avance actual</span><span style="display: flex; align-items: center; gap: 4px"><svg width="8" height="8" viewBox="0 0 10 10" style="fill: #0B3D78"><polygon points="0,0 10,0 5,8"></polygon></svg>Días hábiles (80%)</span></div>
</div>
<div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; width: 100%; margin-top: auto; border-top: 1px solid #EEF0EC; padding-top: 14px">
<div style="display: flex; flex-direction: column; gap: 4px"><span style="font-size: 12px; color: #505A69">Ticket Promedio</span><span style="font-size: 17px; font-weight: 600">11,950</span></div>
<div style="display: flex; flex-direction: column; gap: 4px"><span style="font-size: 12px; color: #505A69">TAPP Mes</span><span style="font-size: 17px; font-weight: 600">48.63%</span></div>
<div style="display: flex; flex-direction: column; gap: 4px"><span style="font-size: 12px; color: #505A69">TAPP Mínima</span><span style="font-size: 17px; font-weight: 600">55.76%</span></div>
</div>
</button>

<!-- Tasas -->
<button type="button" onClick="{{open.tasas}}" style="font: inherit; color: inherit; text-align: left; cursor: pointer; background: #FFFFFF; border: 1px solid #E1E4E8; border-radius: 14px; padding: 16px 20px; display: flex; flex-direction: column; gap: 10px; min-height: 285px; box-sizing: border-box">
<div style="display: flex; align-items: center; gap: 10px; width: 100%"><span style="width: 36px; height: 36px; border-radius: 9px; background: #E7EEF7; color: #0B3D78; display: flex; align-items: center; justify-content: center"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 5 5 19"></path><circle cx="7" cy="7" r="2.5"></circle><circle cx="17" cy="17" r="2.5"></circle></svg></span><span style="font-size: 16px; font-weight: 600; flex-grow: 1">Autonomía de tasas</span><span style="font-size: 13px; font-weight: 600; color: #0B3D78">Ver detalle →</span></div>
<div style="display: flex; align-items: baseline; gap: 12px; width: 100%"><span style="font-family: 'IBM Plex Sans Condensed', sans-serif; font-size: 34px; font-weight: 600">−277 pbs</span><span style="font-size: 13px; color: #505A69">distancia a la TAPP mínima</span></div>
<div style="display: flex; flex-direction: column; gap: 8px; width: 100%">
<div style="display: flex; align-items: center; gap: 10px; font-size: 13px"><span style="width: 110px; color: #505A69">TAPP mínima</span><span style="flex-grow: 1; height: 10px; display: flex"><span style="width: 100%; background: #9DB4D3; border-radius: 5px"></span></span><span style="width: 56px; text-align: right">55.76%</span></div>
<div style="display: flex; align-items: center; gap: 10px; font-size: 13px"><span style="width: 110px; color: #505A69">TAPP mes</span><span style="flex-grow: 1; height: 10px; display: flex"><span style="width: 95%; background: #C77700; border-radius: 5px"></span></span><span style="width: 56px; text-align: right; font-weight: 600">52.98%</span></div>
</div>
<div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; width: 100%; margin-top: auto; border-top: 1px solid #EEF0EC; padding-top: 14px">
<div style="display: flex; flex-direction: column; gap: 4px"><span style="font-size: 12px; color: #505A69">Operaciones</span><span style="font-size: 17px; font-weight: 600">5</span></div>
<div style="display: flex; flex-direction: column; gap: 4px"><span style="font-size: 12px; color: #505A69">Por Administrador</span><span style="font-size: 17px; font-weight: 600">100%</span></div>
<div style="display: flex; flex-direction: column; gap: 4px"><span style="font-size: 12px; color: #505A69">Encima mínima</span><span style="font-size: 17px; font-weight: 600">0</span></div>
</div>
</button>

<!-- Seguros -->
<button type="button" onClick="{{open.seguros}}" style="font: inherit; color: inherit; text-align: left; cursor: pointer; background: #FFFFFF; border: 1px solid #E1E4E8; border-radius: 14px; padding: 16px 20px; display: flex; flex-direction: column; gap: 10px; min-height: 285px; box-sizing: border-box">
<div style="display: flex; align-items: center; gap: 10px; width: 100%"><span style="width: 36px; height: 36px; border-radius: 9px; background: #E7EEF7; color: #0B3D78; display: flex; align-items: center; justify-content: center"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z"></path></svg></span><span style="font-size: 16px; font-weight: 600; flex-grow: 1">Seguros</span><span style="font-size: 13px; font-weight: 600; color: #0B3D78">Ver detalle →</span></div>
<div style="display: flex; flex-direction: column; gap: 8px; width: 100%">
<div style="display: flex; flex-direction: column; gap: 2px; width: 100%">
<div style="display: flex; justify-content: space-between; font-size: 12px"><span style="color: #16202E">Ingresos (PEN)</span><span style="font-weight: 600; color: #505A69">12,450 / 15,000 meta</span></div>
<div style="height: 9px; background: #EEF0EC; border-radius: 5px; display: flex"><span style="width: 83%; background: #9DB4D3; border-radius: 5px"></span></div>
</div>
<div style="display: flex; flex-direction: column; gap: 2px; width: 100%">
<div style="display: flex; justify-content: space-between; font-size: 12px"><span style="color: #16202E">Pólizas Totales</span><span style="font-weight: 600; color: #505A69">42 / 50 meta</span></div>
<div style="height: 9px; background: #EEF0EC; border-radius: 5px; display: flex; overflow: hidden">
<div style="width: 84%; height: 100%; display: flex; border-radius: 5px; overflow: hidden">
<span style="width: 38.1%; background: #0B3D78; height: 100%; border-right: 1px solid #FFFFFF" title="Multiriesgo"></span>
<span style="width: 23.8%; background: #2E7D32; height: 100%; border-right: 1px solid #FFFFFF" title="Prot. Cuota"></span>
<span style="width: 19.0%; background: #C77700; height: 100%; border-right: 1px solid #FFFFFF" title="Vida Segura"></span>
<span style="width: 9.5%; background: #8E24AA; height: 100%; border-right: 1px solid #FFFFFF" title="Oncológico"></span>
<span style="width: 7.1%; background: #00838F; height: 100%; border-right: 1px solid #FFFFFF" title="Agropecuario"></span>
<span style="width: 2.5%; background: #D32F2F; height: 100%" title="Prot. Total"></span>
</div>
</div>
</div>
<div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 4px 6px; font-size: 11px; background: #F7F8F6; padding: 6px 8px; border-radius: 8px; border: 1px solid #E1E4E8; width: 100%">
<div style="display: flex; align-items: center; gap: 4px; overflow: hidden"><span style="width: 6px; height: 6px; border-radius: 50%; background: #0B3D78; flex-shrink: 0"></span><span style="color: #505A69; text-overflow: ellipsis; overflow: hidden; white-space: nowrap">Multiriesgo:</span><b style="color: #16202E">16</b></div>
<div style="display: flex; align-items: center; gap: 4px; overflow: hidden"><span style="width: 6px; height: 6px; border-radius: 50%; background: #2E7D32; flex-shrink: 0"></span><span style="color: #505A69; text-overflow: ellipsis; overflow: hidden; white-space: nowrap">Prot. Cuota:</span><b style="color: #16202E">10</b></div>
<div style="display: flex; align-items: center; gap: 4px; overflow: hidden"><span style="width: 6px; height: 6px; border-radius: 50%; background: #C77700; flex-shrink: 0"></span><span style="color: #505A69; text-overflow: ellipsis; overflow: hidden; white-space: nowrap">Vida Segura:</span><b style="color: #16202E">8</b></div>
<div style="display: flex; align-items: center; gap: 4px; overflow: hidden"><span style="width: 6px; height: 6px; border-radius: 50%; background: #8E24AA; flex-shrink: 0"></span><span style="color: #505A69; text-overflow: ellipsis; overflow: hidden; white-space: nowrap">Oncológico:</span><b style="color: #16202E">4</b></div>
<div style="display: flex; align-items: center; gap: 4px; overflow: hidden"><span style="width: 6px; height: 6px; border-radius: 50%; background: #00838F; flex-shrink: 0"></span><span style="color: #505A69; text-overflow: ellipsis; overflow: hidden; white-space: nowrap">Agropecuario:</span><b style="color: #16202E">3</b></div>
<div style="display: flex; align-items: center; gap: 4px; overflow: hidden"><span style="width: 6px; height: 6px; border-radius: 50%; background: #D32F2F; flex-shrink: 0"></span><span style="color: #505A69; text-overflow: ellipsis; overflow: hidden; white-space: nowrap">Prot. Total:</span><b style="color: #16202E">1</b></div>
</div>
</div>
<div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; width: 100%; margin-top: auto; border-top: 1px solid #EEF0EC; padding-top: 14px">
<div style="display: flex; flex-direction: column; gap: 4px"><span style="font-size: 12px; color: #505A69">Penetración</span><span style="font-size: 17px; font-weight: 600">87.5%</span><span style="font-size: 12px; color: #1B6B43">+5.2%</span></div>
<div style="display: flex; flex-direction: column; gap: 4px"><span style="font-size: 12px; color: #505A69">Sin Venta</span><span style="font-size: 17px; font-weight: 600; color: #A1231B">3 ases.</span><span style="font-size: 12px; color: #A1231B">Alerta</span></div>
<div style="display: flex; flex-direction: column; gap: 4px"><span style="font-size: 12px; color: #505A69">Ticket Prima</span><span style="font-size: 17px; font-weight: 600">173</span><span style="font-size: 12px; color: #505A69">promedio</span></div>
</div>
</button>


<!-- Recuperación y mora -->
<button type="button" onClick="{{open.mora}}" style="font: inherit; color: inherit; text-align: left; cursor: pointer; background: #FFFFFF; border: 1px solid #E1E4E8; border-radius: 14px; padding: 16px 20px; display: flex; flex-direction: column; gap: 10px; min-height: 285px; box-sizing: border-box">
<div style="display: flex; align-items: center; gap: 10px; width: 100%"><span style="width: 36px; height: 36px; border-radius: 9px; background: #FBE6E4; color: #A1231B; display: flex; align-items: center; justify-content: center"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5"></path><path d="M12 16h.01"></path></svg></span><span style="font-size: 16px; font-weight: 600; flex-grow: 1">Recuperación y mora</span><span style="font-size: 13px; font-weight: 600; color: #0B3D78">Ver detalle →</span></div>
<div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; width: 100%">
<div style="display: flex; flex-direction: column; gap: 3px; background: #F0F5F3; border: 1px solid #DFE9E3; border-radius: 10px; padding: 10px 12px; box-sizing: border-box">
<span style="font-size: 10px; font-weight: 600; letter-spacing: 0.07em; color: #405B4D">PREVENTIVA</span>
<span style="font-size: 12px; color: #505A69">−30 a 0 días</span>
<span style="font-family: 'IBM Plex Sans Condensed', sans-serif; font-size: 30px; line-height: 1.15; font-weight: 600; color: #16202E; margin-top: 3px">95.94%</span>
<span style="font-size: 11px; color: #505A69">Meta: —</span>
<span style="font-size: 10px; color: #687381">Brecha pendiente de meta</span>
</div>
<div style="display: flex; flex-direction: column; gap: 3px; background: #F5F2EF; border: 1px solid #E9E1DA; border-radius: 10px; padding: 10px 12px; box-sizing: border-box">
<span style="font-size: 10px; font-weight: 600; letter-spacing: 0.07em; color: #795641">MORA TEMPRANA</span>
<span style="font-size: 12px; color: #505A69">1 a 30 días</span>
<span style="font-family: 'IBM Plex Sans Condensed', sans-serif; font-size: 30px; line-height: 1.15; font-weight: 600; color: #16202E; margin-top: 3px">0.00%</span>
<span style="font-size: 11px; color: #505A69">Meta: —</span>
<span style="font-size: 10px; color: #687381">Brecha pendiente de meta</span>
</div>
</div>
<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 4px 8px; width: 100%; font-size: 12px">
<span style="color: #505A69">Recuperado en el mes</span>
<span style="font-weight: 600; color: #16202E">S/ — <span style="font-weight: 400; color: #505A69">· — ops</span></span>
</div>
<div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; width: 100%; margin-top: auto; border-top: 1px solid #EEF0EC; padding-top: 14px">
<div style="display: flex; flex-direction: column; gap: 4px"><span style="font-size: 12px; color: #505A69">Clientes en mora</span><span style="font-size: 17px; font-weight: 600">5</span><span style="font-size: 12px; color: #A1231B">+4 vs cierre</span></div>
<div style="display: flex; flex-direction: column; gap: 4px"><span style="font-size: 12px; color: #505A69">Saldo mora ≥1 día</span><span style="font-size: 17px; font-weight: 600">S/ —</span><span style="font-size: 12px; color: #505A69">Saldo total en atraso</span></div>
<div style="display: flex; flex-direction: column; gap: 4px"><span style="font-size: 12px; color: #505A69">Ingresos a mora · mes</span><span style="font-size: 17px; font-weight: 600">— ops</span><span style="font-size: 12px; color: #505A69">S/ —</span></div>
</div>
</button>

</section>

<!-- Diálogo de detalle -->
<sc-if value="{{isOpen}}" hint-placeholder-val="{{false}}">
<div style="position: fixed; left: 0; top: 0; width: 100vw; height: 100vh; background: rgba(16, 24, 40, 0.5); z-index: 100"></div>
<div role="dialog" aria-modal="true" aria-label="{{dlg.title}}" style="position: fixed; left: 50%; top: 50%; transform: translate(-50%, -50%); width: min(1220px, 94vw); height: min(800px, 90vh); background: #FFFFFF; border-radius: 16px; display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 24px 64px rgba(16, 24, 40, 0.28); z-index: 101">
<div style="background: #0B3D78; color: #FFFFFF; padding: 22px 28px; display: flex; align-items: center; gap: 16px">
<div style="display: flex; flex-direction: column; gap: 4px; flex-grow: 1">
<div style="font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.8">Detalle · Yactayo Luque Magali Mariet</div>
<h2 style="margin: 0; font-size: 26px; font-weight: 700">{{dlg.title}}</h2>
<div style="font-size: 14px; opacity: 0.85">{{dlg.sub}}</div>
</div>
<nav aria-label="Otras vistas" style="display: flex; gap: 6px">
<sc-for list="{{tabs}}" as="tb" hint-placeholder-count="6">
<sc-if value="{{tb.active}}" hint-placeholder-val="{{false}}"><button type="button" onClick="{{tb.go}}" style="font: inherit; font-size: 13px; font-weight: 600; min-height: 36px; padding: 0 14px; border-radius: 999px; border: 1px solid #FFFFFF; background: #FFFFFF; color: #0B3D78; cursor: pointer">{{tb.label}}</button></sc-if>
<sc-if value="{{tb.idle}}" hint-placeholder-val="{{true}}"><button type="button" onClick="{{tb.go}}" style="font: inherit; font-size: 13px; font-weight: 500; min-height: 36px; padding: 0 14px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, 0.4); background: transparent; color: #FFFFFF; cursor: pointer">{{tb.label}}</button></sc-if>
</sc-for>
</nav>
<button type="button" aria-label="Cerrar" onClick="{{close}}" style="width: 44px; height: 44px; border-radius: 999px; border: none; background: rgba(255, 255, 255, 0.14); color: #FFFFFF; display: flex; align-items: center; justify-content: center; cursor: pointer"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12"></path><path d="M18 6 6 18"></path></svg></button>
</div>
<div style="flex-grow: 1; overflow: auto; padding: 24px 28px 32px; display: flex; flex-direction: column; gap: 24px; background: #F3F4F1">

<div style="display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px">
<sc-for list="{{dlg.kpis}}" as="k" hint-placeholder-count="4">
<div style="background: #FFFFFF; border: 1px solid #E1E4E8; border-radius: 12px; padding: 16px 18px; display: flex; flex-direction: column; gap: 6px">
<span style="font-size: 12px; color: #505A69">{{k.label}}</span>
<span style="font-family: 'IBM Plex Sans Condensed', sans-serif; font-size: 28px; font-weight: 600">{{k.value}}</span>
<sc-if value="{{k.good}}" hint-placeholder-val="{{false}}"><span style="align-self: flex-start; font-size: 12px; font-weight: 600; background: #E4F1E9; color: #1B6B43; border-radius: 999px; padding: 3px 10px">{{k.delta}}</span></sc-if>
<sc-if value="{{k.warn}}" hint-placeholder-val="{{false}}"><span style="align-self: flex-start; font-size: 12px; font-weight: 600; background: #FBEEDA; color: #8A4B00; border-radius: 999px; padding: 3px 10px">{{k.delta}}</span></sc-if>
<sc-if value="{{k.bad}}" hint-placeholder-val="{{false}}"><span style="align-self: flex-start; font-size: 12px; font-weight: 600; background: #FBE6E4; color: #A1231B; border-radius: 999px; padding: 3px 10px">{{k.delta}}</span></sc-if>
<sc-if value="{{k.neutral}}" hint-placeholder-val="{{true}}"><span style="font-size: 12px; color: #505A69">{{k.delta}}</span></sc-if>
</div>
</sc-for>
</div>

<sc-if value="{{dlg.hasFilters}}" hint-placeholder-val="{{false}}">
<div style="display: flex; gap: 12px; flex-wrap: wrap; background: #FFFFFF; border: 1px solid #E1E4E8; border-radius: 12px; padding: 14px 16px">
<sc-for list="{{dlg.filters}}" as="f" hint-placeholder-count="6">
<label style="display: flex; flex-direction: column; gap: 4px; font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: #505A69">{{f.t}}<select style="font: inherit; font-size: 14px; font-weight: 400; letter-spacing: 0; text-transform: none; color: #16202E; min-width: 160px; height: 40px; border: 1px solid #C9CED6; border-radius: 8px; padding: 0 10px; background: #FFFFFF"><option>Todo</option></select></label>
</sc-for>
</div>
</sc-if>

<sc-for list="{{dlg.sections}}" as="s" hint-placeholder-count="2">
<section style="display: flex; flex-direction: column; gap: 10px">
<div style="display: flex; align-items: baseline; gap: 12px"><h3 style="margin: 0; font-size: 17px; font-weight: 600">{{s.title}}</h3><sc-if value="{{s.hasNote}}" hint-placeholder-val="{{false}}"><span style="font-size: 13px; color: #505A69">{{s.note}}</span></sc-if></div>
<div style="background: #FFFFFF; border: 1px solid #E1E4E8; border-radius: 12px; overflow: hidden">
<div style="display: flex; align-items: center; gap: 12px; background: #0B3D78; color: #FFFFFF; font-size: 12px; font-weight: 600; letter-spacing: 0.03em; text-transform: uppercase; padding: 12px 16px">
<span style="flex: 2.4 1 0">{{s.c0}}</span>
<sc-for list="{{s.cols}}" as="c" hint-placeholder-count="3"><span style="flex: 1 1 0; text-align: right">{{c.t}}</span></sc-for>
<sc-if value="{{s.hasSt}}" hint-placeholder-val="{{false}}"><span style="width: 110px; text-align: left; padding-left: 12px">Estado</span></sc-if>
</div>
<sc-for list="{{s.rows}}" as="r" hint-placeholder-count="6">
<div style="display: flex; align-items: center; gap: 12px; padding: 11px 16px; border-top: 1px solid #EEF0EC; font-size: 14px">
<span style="flex: 2.4 1 0">{{r.label}}</span>
<sc-for list="{{r.vals}}" as="v" hint-placeholder-count="3"><span style="flex: 1 1 0; text-align: right">{{v.t}}</span></sc-for>
<sc-if value="{{s.hasSt}}" hint-placeholder-val="{{false}}"><span style="width: 110px; padding-left: 12px; display: flex">
<sc-if value="{{r.stGood}}" hint-placeholder-val="{{false}}"><span style="display: flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; background: #E4F1E9; color: #1B6B43; border-radius: 999px; padding: 3px 10px"><span style="width: 7px; height: 7px; border-radius: 50%; background: #1B6B43"></span>Favorable</span></sc-if>
<sc-if value="{{r.stWarn}}" hint-placeholder-val="{{false}}"><span style="display: flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; background: #FBEEDA; color: #8A4B00; border-radius: 999px; padding: 3px 10px"><span style="width: 7px; height: 7px; border-radius: 50%; background: #C77700"></span>Revisar</span></sc-if>
<sc-if value="{{r.stBad}}" hint-placeholder-val="{{false}}"><span style="display: flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; background: #FBE6E4; color: #A1231B; border-radius: 999px; padding: 3px 10px"><span style="width: 7px; height: 7px; border-radius: 50%; background: #A1231B"></span>Alerta</span></sc-if>
</span></sc-if>
</div>
</sc-for>
</div>
</section>
</sc-for>

</div>
</div>
</sc-if>

</div>
</x-dc>
<script type="text/x-dc" data-dc-script data-props='{"dialogo":{"editor":"enum","options":["none","cartera","clientes","colocacion","tasas","seguros","mora"],"default":"none"},"$preview":{"width":1440,"height":850}}'>
class Component extends DCLogic {
  renderVals() {
    var self = this;
    var cur = (this.state && this.state.open) || this.props.dialogo || 'none';
    var go = function (k) { return function () { self.setState({ open: k }); }; };

    var row = function (label, vals, st) {
      return { label: label, vals: vals.map(function (t) { return { t: t }; }),
        stGood: st === 'g', stWarn: st === 'w', stBad: st === 'b' };
    };
    var sec = function (title, c0, cols, rows, hasSt, note) {
      return { title: title, c0: c0, cols: cols.map(function (t) { return { t: t }; }),
        rows: rows, hasSt: !!hasSt, note: note || '', hasNote: !!note };
    };
    var kpi = function (label, value, delta, tone) {
      return { label: label, value: value, delta: delta,
        good: tone === 'g', warn: tone === 'w', bad: tone === 'b', neutral: !tone };
    };
    var noFilters = { hasFilters: false, filters: [] };

    var D = {
      cartera: {
        title: 'Cartera', sub: 'Presupuesto, stock, tasas y calidad de la cartera',
        kpis: [
          kpi('Stock de cartera', '3,254,743', '−274,224 vs cierre', 'b'),
          kpi('Saldo medio de cartera', '1,775,379', '−1,671,566', 'b'),
          kpi('TAPP stock', '23.32%', '+23 pbs', 'g'),
          kpi('TAPP mes', '48.63%', '+2,081 pbs', 'g')
        ],
        sections: [
          sec('Presupuesto vs ejecutado', 'Variable', ['Presupuesto', 'Ejecutado'], [
            row('Variación de cartera', ['—', '−274,224'], 'w'),
            row('Variación de clientes', ['—', '1'], 'w'),
            row('Variación de clientes (mes pasado)', ['—', '8'], 'w'),
            row('Variación de clientes (mes antepasado)', ['—', '−14'], 'w'),
            row('Ratio de efectividad tramo −30 a 0 días', ['—', '95.94%'], 'w'),
            row('Ratio de efectividad tramo 1 a 30 días', ['—', '0.00%'], 'w'),
            row('Ratio de mora real', ['—', '2.20%'], 'w'),
            row('Ratio de mora > 1 día', ['—', '5.12%'], 'w'),
            row('Tamaño de grupo desembolsado', ['—', '0'], 'w')
          ], true, 'Presupuesto pendiente de carga'),
          sec('Evolución vs cierre del mes anterior', 'Variable', ['Cierre mes ant.', 'Ejecutado', 'Variación'], [
            row('Stock de cartera', ['3,528,967', '3,254,743', '−274,224'], 'b'),
            row('Stock de clientes', ['142', '143', '1'], 'g'),
            row('Número de clientes nuevos', ['2', '2', '0'], 'g'),
            row('TAPP stock', ['23.09%', '23.32%', '23 pbs'], 'g'),
            row('TAPP mes', ['27.82%', '48.63%', '2,081 pbs'], 'g'),
            row('Saldo puntual de mora real', ['0', '71,499', '71,499'], 'b'),
            row('Variación de mora real', ['0', '71,499', '71,499'], 'b'),
            row('Número de clientes en mora', ['1', '5', '4'], 'b'),
            row('Clientes en tramo −30 a 0 días', ['107', '111', '4'], 'w'),
            row('Saldo en tramo −30 a 0 días', ['2,343,998', '2,256,240', '−87,759'], 'g'),
            row('Clientes en mora tramo 1 a 30 días', ['1', '4', '3'], 'b'),
            row('Saldo en mora tramo 1 a 30 días', ['71,499', '95,197', '23,698'], 'b'),
            row('Gasto de provisiones (proyectado)', ['—', '—', '—'], 'b'),
            row('Saldo medio de cartera', ['3,446,945', '1,775,379', '−1,671,566'], 'b')
          ], true)
        ]
      },
      clientes: {
        title: 'Clientes', sub: 'Nuevos, recurrentes y distribución por producto',
        kpis: [
          kpi('Stock de clientes', '143', '+1 vs 142', 'g'),
          kpi('Clientes nuevos', '2', 'Igual al cierre', 'g'),
          kpi('Clientes recurrentes', '6', '−14 vs 20', 'b'),
          kpi('Ticket prom. desembolsados', '3,538', '−13,131', 'b')
        ],
        sections: [
          sec('Clientes nuevos y recurrentes', 'Variable', ['Cierre mes ant.', 'A hoy', 'Variación'], [
            row('Número de clientes nuevos', ['2', '2', '0'], 'g'),
            row('Número de clientes recurrentes', ['20', '6', '−14'], 'b'),
            row('Total de clientes desembolsados', ['22', '8', '−14'], 'b'),
            row('Ticket promedio de clientes nuevos', ['5,000', '6,000', '1,000'], 'g'),
            row('Ticket promedio de clientes recurrentes', ['17,835', '2,717', '−15,119'], 'b'),
            row('Ticket promedio de clientes desembolsados', ['16,668', '3,538', '−13,131'], 'b')
          ], true),
          sec('Productos core', 'Producto', ['Cierre mes ant.', 'A hoy', 'Variación'], [
            row('Agropecuario', ['26', '24', '−2'], 'b'),
            row('Construyendo Confianza', ['1', '2', '1'], 'g'),
            row('Crédito Educativo', ['4', '4', '0'], 'g'),
            row('Emprendiendo Confianza', ['126', '121', '−5'], 'w'),
            row('Créditos FAE', ['1', '1', '0'], 'g'),
            row('Impulsa MyPerú', ['8', '8', '0'], 'g'),
            row('Total', ['166', '160', '−6'], 'w')
          ], true),
          sec('Productos no core', 'Producto', ['Cierre mes ant.', 'A hoy', 'Variación'], [
            row('Garantía Líquida', ['1', '1', '0'], 'g')
          ], true),
          sec('Total de clientes', 'Concepto', ['Cierre mes ant.', 'A hoy', 'Variación'], [
            row('Total', ['142', '143', '1'], 'g')
          ], true)
        ]
      },
      colocacion: {
        title: 'Colocación y metas', sub: 'Monitor de metas de desembolso del mes',
        kpis: [
          kpi('Cumplimiento operaciones', '53.33%', '8 de 15 operaciones', 'w'),
          kpi('Cumplimiento monto', '6.51%', 'Muy por debajo del avance del mes', 'b'),
          kpi('Monto desembolsado', '14,800', '5 operaciones con tasa', null),
          kpi('Días hábiles transcurridos', '96%', 'Estimado al 29/09', null)
        ],
        sections: [
          sec('Monitor diario de metas', 'Día · fecha', ['Ops', 'Meta', '% cumpl.', 'Ops acum.', 'Meta acum.', '% acum.', '% días'], [
            row('1 · Mar 01/09', ['0', '1', '0.00%', '0', '15', '0.00%', '3.85%']),
            row('2 · Mié 02/09', ['0', '0', '100.00%', '0', '15', '0.00%', '7.69%']),
            row('3 · Jue 03/09', ['0', '0', '100.00%', '0', '15', '0.00%', '11.54%']),
            row('4 · Vie 04/09', ['1', '0', '100.00%', '1', '15', '6.67%', '15.38%']),
            row('5 · Sáb 05/09', ['0', '1', '0.00%', '1', '15', '6.67%', '19.23%']),
            row('6 · Lun 07/09', ['0', '1', '0.00%', '1', '15', '6.67%', '23.08%']),
            row('7 · Mar 08/09', ['0', '1', '0.00%', '1', '15', '6.67%', '26.92%']),
            row('8 · Mié 09/09', ['1', '1', '100.00%', '2', '15', '13.33%', '30.77%']),
            row('9 · Jue 10/09', ['0', '1', '0.00%', '2', '15', '13.33%', '34.62%'])
          ], false, 'Vista preliminar: días 1 a 9')
        ]
      },
      tasas: {
        title: 'Autonomía de tasas', sub: 'Resumen de gestión de tasas por nivel de autonomía',
        kpis: [
          kpi('Operaciones', '5', '100% por Administrador', 'w'),
          kpi('Monto desembolsado', '14,800', 'Ticket 2,960', null),
          kpi('TAPP mes vs mínima', '52.98%', 'Mínima 55.76%', 'w'),
          kpi('Distancia', '−277 pbs', 'Bajo la TAPP mínima', 'b')
        ],
        sections: [
          sec('Resumen gestión de tasas', 'Rubro', ['Encima mín.', 'A la mín.', 'Administr.', 'Gte. reg. / J. incl.', 'Gte. territ.', 'Total auton.', 'Total'], [
            row('Nro. operaciones', ['0', '0', '5', '0', '0', '5', '5']),
            row('Nro. operaciones (%)', ['0.00%', '0.00%', '100.00%', '0.00%', '0.00%', '100.00%', '100.00%']),
            row('Monto desembolsado', ['0', '0', '14,800', '0', '0', '14,800', '14,800']),
            row('Monto desembolsado (%)', ['0.00%', '0.00%', '100.00%', '0.00%', '0.00%', '100.00%', '100.00%']),
            row('Ticket promedio (PEN)', ['0', '0', '2,960', '0', '0', '2,960', '2,960']),
            row('TAPP mes (%)', ['0.00%', '0.00%', '52.98%', '0.00%', '0.00%', '52.98%', '52.98%']),
            row('TAPP mínima referencial (%)', ['0.00%', '0.00%', '55.76%', '0.00%', '0.00%', '55.76%', '55.76%']),
            row('Distancia (pbs)', ['0', '0', '−277', '0', '0', '−277', '−277'])
          ], false),
          sec('Operaciones desembolsadas por producto', 'Producto', ['Encima mín.', 'A la mín.', 'Administr.', 'Total ops.', '% ops.'], [
            row('Construyendo Confianza', ['0', '0', '1', '1', '20.00%']),
            row('Emprendiendo Confianza', ['[—]', '[—]', '[—]', '[—]', '[—]'])
          ], false, 'Filas restantes por completar con la fuente')
        ]
      },
      seguros: {
        title: 'Seguros', sub: 'Pólizas del mes y stock, expresado en PEN y %',
        kpis: [
          kpi('Multiriesgo · mes', '0', '−5 vs cierre', 'b'),
          kpi('Multiriesgo · stock', '26', '−2 vs cierre', 'b'),
          kpi('Protec. cuota · stock', '1', 'Sin variación', 'w'),
          kpi('Agropecuarios', 'Sin dato', 'Pendiente de fuente', null)
        ],
        sections: [
          sec('Seguros', 'Variable', ['Cierre anterior', 'Ejecutado', 'Variación'], [
            row('Multiriesgo (nro. pólizas mes)', ['5', '0', '−5'], 'b'),
            row('Multiriesgo (nro. pólizas stock)', ['28', '26', '−2'], 'b'),
            row('Mult. crédito y protec. cuota (pólizas mes)', ['—', '—', '—'], 'w'),
            row('Mult. crédito y protec. cuota (pólizas stock)', ['1', '1', '0'], 'w'),
            row('Seguros agropecuarios (pólizas mes)', ['—', '—', '—'], 'w'),
            row('Seguros agropecuarios (pólizas stock)', ['—', '—', '—'], 'w')
          ], true)
        ]
      },
      mora: {
        title: 'Recuperación y mora', sub: 'Efectividad de gestión y cartera por vencer',
        hasFilters: true,
        filters: ['Tramo', 'Producto', 'Compromiso roto', '0 cuota', '1 cuota', 'Tramo días gestión'].map(function (t) { return { t: t }; }),
        kpis: [
          kpi('Ratio de mora real', '2.20%', 'Saldo 71,499', 'b'),
          kpi('Ratio de mora > 1 día', '5.12%', 'Tramo 1–30: 95,197', 'b'),
          kpi('Clientes en mora', '5', '+4 vs cierre', 'b'),
          kpi('Efectividad −30 a 0', '95.94%', 'Tramo 1–30: 0.00%', 'w')
        ],
        sections: [
          sec('Detalle de efectividades', 'Cliente', ['Saldo', 'Tramo inicio', 'Días', 'Gestiones', 'Últ. gestión', 'Resultado'], [
            row('Vilca Alberto Santria', ['71,498.75', '1 a 30', '45', '5', '2026-09-23', 'Compromiso de pago']),
            row('Arratia Amesquita Jesus Javier', ['62,710.37', '−30 a 0', '24', '6', '2026-09-22', 'Compromiso de pago']),
            row('Pilco Mamani Belinda Rosa', ['22,026.39', '−30 a 0', '26', '7', '2026-09-23', 'Compromiso de pago']),
            row('Pacohuanaco Chino Karin Yessenia', ['5,999.28', '−30 a 0', '12', '3', '2026-09-22', 'Compromiso de pago']),
            row('Choque Ramos Elizabeth', ['4,460.99', '−30 a 0', '14', '3', '2026-09-22', 'Compromiso de pago'])
          ], false, 'Emprendiendo Confianza · todos con registro de gestión'),
          sec('Recuperación preventiva', 'Cliente', ['Cuenta', 'Saldo capital', 'Ingreso a mora', 'Días p/ venc.', 'Teléfono'], [
            row('Torres Rojas Simon', ['332689', '82,524', '2026-10-02', '3', '952213516']),
            row('Maquera Carrillo Nancy', ['3375444', '74,845', '2026-10-02', '3', '—']),
            row('Maquera Llanque Nora', ['464617', '70,000', '2026-10-02', '3', '840017']),
            row('Choque Aquino Edwin', ['5055329', '64,162', '2026-10-02', '3', '—']),
            row('Enriquez Ancco Giampier Abdon', ['4524661', '49,882', '2026-10-02', '3', '—']),
            row('Limachi Quispe Javier', ['548364', '46,991', '2026-10-02', '3', '—']),
            row('Chambilla Ninaja Nemecio', ['4750236', '46,732', '2026-10-03', '4', '—']),
            row('Copaja Bartra Jose Luis', ['278571', '45,177', '2026-10-02', '3', '952523568']),
            row('Condori Mamani Rosa Elena', ['4427474', '43,594', '2026-10-02', '3', '—']),
            row('Coaquira Feliciano Oscar Gil', ['4032134', '37,968', '2026-10-02', '3', '—']),
